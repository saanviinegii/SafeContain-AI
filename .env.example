# SafeContain AI Environment Configuration Template

# Runtime Environment
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change_me_to_a_secure_random_32_byte_secret_key_in_production
JWT_SECRET_KEY=change_me_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_in_production_AdminSecure2026!

# Graph Configuration
GRAPH_BACKEND=dual
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=SafeContainSecurePassword2026!

# Relational Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safecontain
USE_SQLITE_FALLBACK=true

# Audit Ledger
AUDIT_LEDGER_STORAGE_PATH=audit_ledger.jsonl
VERIFY_AUDIT_INTEGRITY_ON_STARTUP=true

# Solver Bounds
MAX_SOLVER_TIME_SECONDS=5.0
DEFAULT_MAX_CONTAINMENT_BUDGET=10000.0

# Phase 3 — EVM Blockchain Trust & Evidence Integrity (Sepolia Testnet)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_NETWORK_NAME="Ethereum Sepolia Testnet"
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
BLOCKCHAIN_PRIVATE_KEY=your_sepolia_funded_testnet_private_key_without_0x_prefix
BLOCKCHAIN_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_TIMEOUT_SECONDS=10.0
