# SafeContain AI Environment Configuration Template

# Runtime Environment
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=safecontain-enterprise-dev-secret-key-change-in-production-min32bytes

# Graph Configuration
GRAPH_BACKEND=dual
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=SafeContainSecurePassword2026!

# Relational Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safecontain
USE_SQLITE_FALLBACK=true

# Audit Ledger
AUDIT_LEDGER_STORAGE_PATH=audit_ledger.jsonl
VERIFY_AUDIT_INTEGRITY_ON_STARTUP=true

# Solver Bounds
MAX_SOLVER_TIME_SECONDS=5.0
DEFAULT_MAX_CONTAINMENT_BUDGET=10000.0
