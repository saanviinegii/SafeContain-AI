                  type="submit"
                  className="btn-primary"
                  disabled={isLoggingIn}
                  style={{ minWidth: '120px' }}
                >
                  {isLoggingIn ? 'Authenticating...' : 'Sign In'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default App;
